@startuml
actor User
participant FE
participant BE
participant DB

User -> FE : Enter credentials
FE -> BE : POST /login

BE -> DB : Fetch user
DB --> BE : user data

BE -> BE : Verify bcrypt

alt valid
    BE -> BE : Generate JWT
    BE --> FE : Token
    FE --> User : Logged in
else invalid
    BE --> FE : 401 error
end

@enduml